{
  "license": "SEE LICENSE IN LICENSE",
  "name": "swarmtales-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Swarm Tales: AI agent swarms play through stories in acts; their logs become novellas. Built on pi-ai and pi-agent-core",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "start": "tsx --conditions=development apps/cli/src/main.ts",
    "swt": "tsx --conditions=development apps/cli/src/swt.ts",
    "typecheck": "tsc -b",
    "lint": "node --max-old-space-size=12288 node_modules/eslint/bin/eslint.js .",
    "test": "vitest --run --exclude '.claude/**' --exclude '**/node_modules/**'",
    "validate": "tsx --conditions=development apps/cli/src/validate.ts",
    "check:packages": "tsx scripts/check-packages.ts",
    "knip": "knip",
    "build": "pnpm -r build",
    "smoke": "node scripts/smoke-built-cli.mjs",
    "mutants": "tsx --conditions=development scripts/mutants.ts",
    "report:minutes": "tsx --conditions=development apps/cli/src/report.ts",
    "report:run": "tsx --conditions=development apps/cli/src/run-report.ts",
    "report:private": "tsx --conditions=development apps/cli/src/private-report.ts",
    "migrate:gamemaker": "tsx --conditions=development apps/cli/src/migrate-gamemaker.ts",
    "digest": "tsx --conditions=development apps/cli/src/digest.ts",
    "novel": "tsx --conditions=development apps/cli/src/novel.ts",
    "lab": "tsx --conditions=development lab/lab.ts",
    "lab:orders": "tsx --conditions=development lab/orders.ts",
    "lab:judge": "tsx --conditions=development lab/judge.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm check:packages && pnpm knip && pnpm test && pnpm validate && pnpm build && pnpm smoke"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@swarmtales/chronicle": "workspace:*",
    "@swarmtales/contracts": "workspace:*",
    "@swarmtales/legacy-log": "workspace:*",
    "@swarmtales/engine": "workspace:*",
    "@swarmtales/kernel": "workspace:*",
    "@swarmtales/mechanic-arena": "workspace:*",
    "@swarmtales/mechanic-cast": "workspace:*",
    "@swarmtales/mechanic-channels": "workspace:*",
    "@swarmtales/mechanic-motives": "workspace:*",
    "@swarmtales/mechanic-exile": "workspace:*",
    "@swarmtales/mechanic-goals": "workspace:*",
    "@swarmtales/mechanic-ledger": "workspace:*",
    "@swarmtales/mechanic-marks": "workspace:*",
    "@swarmtales/mechanic-names": "workspace:*",
    "@swarmtales/mechanic-petitions": "workspace:*",
    "@swarmtales/mechanic-progression": "workspace:*",
    "@swarmtales/mechanic-puzzles": "workspace:*",
    "@swarmtales/mechanic-receipts": "workspace:*",
    "@swarmtales/mechanic-script": "workspace:*",
    "@swarmtales/mechanic-seal": "workspace:*",
    "@swarmtales/mechanic-shared": "workspace:*",
    "@swarmtales/mechanic-standoff": "workspace:*",
    "@swarmtales/mechanic-standoff-tribunal": "workspace:*",
    "@swarmtales/mechanic-tribunal": "workspace:*",
    "@swarmtales/mechanic-whispers": "workspace:*",
    "@swarmtales/models": "workspace:*",
    "@swarmtales/novelist": "workspace:*",
    "@swarmtales/prompts": "workspace:*",
    "@swarmtales/roles": "workspace:*",
    "@swarmtales/sdk": "workspace:*",
    "@swarmtales/testkit": "workspace:*",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "knip": "6.44.0",
    "tsdown": "0.23.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
