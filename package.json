{
  "name": "swarmtales",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Swarm Tales: AI agent swarms play through stories in acts; their logs become novellas. Built on pi-ai and pi-agent-core",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "start": "tsx src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest --run --exclude '.claude/**' --exclude '**/node_modules/**'",
    "validate": "tsx src/cli/validate.ts",
    "report:minutes": "tsx src/cli/report.ts",
    "report:run": "tsx src/cli/run-report.ts",
    "report:private": "tsx src/cli/private-report.ts",
    "digest": "tsx src/cli/digest.ts",
    "lab": "tsx lab/lab.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm validate"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
