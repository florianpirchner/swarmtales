{
	"name": "swarmtales-workspace",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "LicenseRef-SUL-1.0",
	"description": "Swarm Tales: a laboratory for AI agents. Games and societies on one engine, every word and every private thought on record",
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": ">=22.19"
	},
	"scripts": {
		"swt": "node --conditions development apps/cli/src/bin.ts",
		"typecheck": "tsc -b",
		"lint": "node scripts/lint.ts",
		"test": "vitest --run",
		"check:layers": "node scripts/check-layers.ts",
		"check:licences": "node scripts/check-licences.ts --check",
		"licences:write": "node scripts/check-licences.ts --write",
		"check:signoff": "node scripts/check-signoff.ts",
		"check:pack": "vitest --run scripts/gates/packed-install.test.ts",
		"build": "pnpm -r build",
		"api": "pnpm -r --no-sort api",
		"api:update": "pnpm -r --no-sort api:update",
		"docs:mechanics": "node --conditions=development scripts/mechanic-docs.ts",
		"docs:errors": "node scripts/error-docs/main.ts",
		"docs:games": "node --conditions=development scripts/game-docs/main.ts",
		"check": "node scripts/check.ts",
		"api:freeze": "node --conditions=development scripts/api-freeze/main.ts",
		"release:check": "node scripts/release/check.ts",
		"release:version": "node scripts/release/version.ts",
		"release:names": "node scripts/release/names.ts",
		"pages:pack": "node scripts/pages/main.ts"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@microsoft/api-extractor": "7.60.1",
		"@swarmtales/cli": "workspace:*",
		"@swarmtales/contracts": "workspace:*",
		"@swarmtales/models": "workspace:*",
		"@swarmtales/runlog": "workspace:*",
		"@swarmtales/testkit": "workspace:*",
		"@types/node": "26.6.6",
		"eslint": "9.39.5",
		"eslint-plugin-jsdoc": "65.4.5",
		"tsdown": "0.23.4",
		"typebox": "1.3.27",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.1",
		"vitest": "3.2.7"
	}
}
