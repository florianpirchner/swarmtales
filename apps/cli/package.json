{
	"name": "@swarmtales/cli",
	"version": "1.0.0",
	"description": "The swt command line",
	"type": "module",
	"license": "LicenseRef-SUL-1.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/florianpirchner/swarmtales.git",
		"directory": "apps/cli"
	},
	"engines": {
		"node": ">=22.19"
	},
	"sideEffects": false,
	"swarmtales": {
		"layer": "L6"
	},
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./src/*": "./src/*"
	},
	"publishConfig": {
		"bin": {
			"swt": "./dist/bin.js"
		},
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown"
	},
	"dependencies": {
		"@swarmtales/contracts": "workspace:*",
		"@swarmtales/chain": "workspace:*",
		"@swarmtales/kernel": "workspace:*",
		"@swarmtales/sdk": "workspace:*",
		"@swarmtales/prompts": "workspace:*",
		"@swarmtales/engine": "workspace:*",
		"@swarmtales/runlog": "workspace:*",
		"@swarmtales/models": "workspace:*",
		"@swarmtales/lab": "workspace:*",
		"@swarmtales/testkit": "workspace:*",
		"yaml": "2.9.1",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@swarmtales/mechanic-channels": "workspace:*",
		"@swarmtales/mechanic-ledger": "workspace:*",
		"@swarmtales/mechanic-motives": "workspace:*",
		"@swarmtales/mechanic-whispers": "workspace:*",
		"chess.js": "1.4.0"
	}
}
