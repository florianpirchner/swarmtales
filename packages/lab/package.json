{
	"name": "@swarmtales/lab",
	"version": "0.0.0",
	"private": true,
	"description": "Facts of a run, statistics, experiments and the computed run report",
	"type": "module",
	"license": "Apache-2.0",
	"sideEffects": false,
	"swarmtales": {
		"layer": "L4"
	},
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"api": "api-extractor run",
		"api:update": "api-extractor run --local"
	},
	"dependencies": {
		"@swarmtales/contracts": "workspace:*",
		"@swarmtales/chain": "workspace:*",
		"@swarmtales/runlog": "workspace:*",
		"chess.js": "1.4.0",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@swarmtales/testkit": "workspace:*"
	}
}
