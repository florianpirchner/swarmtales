{
	"name": "swarmtales",
	"version": "1.0.0",
	"description": "Swarm Tales: the umbrella package, re-exports only",
	"type": "module",
	"license": "LicenseRef-SUL-1.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/florianpirchner/swarmtales.git",
		"directory": "packages/swarmtales"
	},
	"engines": {
		"node": ">=22.19"
	},
	"sideEffects": false,
	"swarmtales": {
		"layer": "L6"
	},
	"bin": {
		"swt": "./dist/swt.js"
	},
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./mechanic": {
			"development": "./src/mechanic.ts",
			"types": "./dist/mechanic.d.ts",
			"default": "./dist/mechanic.js"
		},
		"./testing": {
			"development": "./src/testing.ts",
			"types": "./dist/testing.d.ts",
			"default": "./dist/testing.js"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./mechanic": {
				"types": "./dist/mechanic.d.ts",
				"default": "./dist/mechanic.js"
			},
			"./testing": {
				"types": "./dist/testing.d.ts",
				"default": "./dist/testing.js"
			}
		}
	},
	"files": [
		"dist",
		"swarmtales.api.md"
	],
	"scripts": {
		"build": "tsdown",
		"api": "node ../../scripts/api-report.ts",
		"api:update": "node ../../scripts/api-report.ts --update"
	},
	"dependencies": {
		"@swarmtales/cli": "workspace:*",
		"@swarmtales/sdk": "workspace:*",
		"@swarmtales/testkit": "workspace:*"
	}
}
