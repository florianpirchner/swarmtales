{
	"name": "@swarmtales/chain",
	"version": "0.0.0",
	"private": true,
	"description": "Pure verifier of the signed, hash-chained log of a run",
	"type": "module",
	"license": "Apache-2.0",
	"sideEffects": false,
	"swarmtales": {
		"layer": "L0"
	},
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"api": "api-extractor run",
		"api:update": "api-extractor run --local"
	},
	"dependencies": {
		"@noble/curves": "2.4.0",
		"@noble/hashes": "2.4.0",
		"typebox": "1.3.27"
	}
}
