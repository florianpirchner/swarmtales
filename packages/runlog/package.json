{
	"name": "@swarmtales/runlog",
	"version": "1.0.0",
	"description": "Run folder, JSONL sink, chain writer and run verification",
	"type": "module",
	"license": "LicenseRef-SUL-1.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/florianpirchner/swarmtales.git",
		"directory": "packages/runlog"
	},
	"engines": {
		"node": ">=22.19"
	},
	"sideEffects": false,
	"swarmtales": {
		"layer": "L4"
	},
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"files": [
		"dist",
		"runlog.api.md"
	],
	"scripts": {
		"build": "tsdown",
		"api": "node ../../scripts/api-report.ts",
		"api:update": "node ../../scripts/api-report.ts --update"
	},
	"dependencies": {
		"@swarmtales/contracts": "workspace:*",
		"@swarmtales/chain": "workspace:*",
		"typebox": "1.3.27"
	}
}
