{
	"name": "@swarmtales/runlog",
	"version": "0.0.0",
	"private": true,
	"description": "Run folder, JSONL sink, chain writer and run verification",
	"type": "module",
	"license": "Apache-2.0",
	"sideEffects": false,
	"swarmtales": {
		"layer": "L4"
	},
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"api": "api-extractor run",
		"api:update": "api-extractor run --local"
	},
	"dependencies": {
		"@swarmtales/contracts": "workspace:*",
		"@swarmtales/chain": "workspace:*"
	}
}
