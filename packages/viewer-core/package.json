{
	"name": "@swarmtales/viewer-core",
	"version": "0.0.0",
	"private": true,
	"description": "Viewer library: readers and the event model of a run",
	"type": "module",
	"license": "LicenseRef-SUL-1.0",
	"sideEffects": false,
	"swarmtales": {
		"layer": "L5"
	},
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"api": "node ../../scripts/api-report.ts",
		"api:update": "node ../../scripts/api-report.ts --update"
	},
	"dependencies": {
		"@swarmtales/contracts": "workspace:*",
		"@swarmtales/chain": "workspace:*",
		"typebox": "1.3.27"
	}
}
