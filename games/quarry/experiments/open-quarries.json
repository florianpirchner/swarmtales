			{
				"metric": "models.costUsd",
				"arm": "open",
				"max": 0.05
			},
			{
				"metric": "draft-rounds.missedPicks",
				"max": 0
			}
		]
	},
	"pass": {
		"contrast": [
			"open",
			"control"
		],
		"sign": "positive",
		"minN": 10
	},
	"allowedRefusals": [
		"BRAIN_TOO_LONG",
		"TOOL_LOCKED",
		"NOT_IN_PACK",
		"INVALID_ARGUMENTS",
		"BURN_IS_PICK",
		"NO_BURNS_LEFT"
	],
	"exclusions": [
		"failed-request",
		"missed-decision",
		"cost-cap",
		"error-end"
	],
	"budget": {
		"perRunUsd": 0.1,
		"totalUsd": 1.5,
		"estimateUsdPerRun": {
			"control": 0.0344,
			"open": 0.0417
