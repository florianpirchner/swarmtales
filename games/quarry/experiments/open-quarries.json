{
	"format": "swarmtales-experiment",
	"version": 1,
	"id": "quarry-open-quarries",
	"question": "Does showing every hand raise the table's points?",
	"purpose": "confirmatory",
	"game": "games/quarry/game.ts",
	"model": {
		"provider": "anthropic",
		"id": "haiku",
		"thinking": "medium"
	},
	"arms": [
		{
			"id": "control",
			"params": {},
			"control": true
		},
		{
			"id": "open",
			"params": {
				"openHands": true
			}
		}
	],
	"seeds": [
		31,
		37,
		41,
		43,
		47,
		53,
		59,
		61,
		67,
		71,
		73,
		79
	],
	"replicates": 1,
	"design": "paired",
	"metrics": {
		"primary": "draft-rounds.tablePoints",
		"secondary": [
			"draft-rounds.sharedLanes",
			"strategy-brain.brainWrites"
		],
