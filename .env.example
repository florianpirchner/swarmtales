# Template for .env: copy to .env and add your key.
# .env itself is ignored by git.

# Default provider: OpenRouter (the story chooses the model)
OPENROUTER_API_KEY=

# Alternative: direct Anthropic API, Claude Haiku 5.5 (only for --provider anthropic).
# The arena reads ARENA_ANTHROPIC_API_KEY, not ANTHROPIC_API_KEY.
# ARENA_ANTHROPIC_API_KEY=

# Alternative: direct DeepSeek API (only for --provider deepseek)
# DEEPSEEK_API_KEY=

# Alternative: direct Z.ai API (only for --provider zai)
# ZAI_API_KEY=

# Override the model choice (CLI flags take precedence)
# ARENA_PROVIDER=openrouter
# ARENA_MODEL=deepseek/deepseek-v4.1-flash-1017
# ARENA_MODEL=glm-flash          # alias for z-ai/glm-5.3-flash

# Model for the digest's optional chronicle (pnpm digest ... --chronicle);
# without these the digest uses the run's model, CLI flags take precedence
# ARENA_DIGEST_PROVIDER=openrouter
# ARENA_DIGEST_MODEL=deepseek/deepseek-v4.1-flash-1017

# Model of the run reporter (REPORT.md after every run); the default is
# DeepSeek V4.1 Flash via OpenRouter, CLI flags take precedence
# ARENA_REPORTER_PROVIDER=openrouter
# ARENA_REPORTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# Self-hosted OpenAI-compatible endpoint
# ARENA_BASE_URL=https://gateway.example/v1
# ARENA_MODEL_IDS=arena-large
# ARENA_CUSTOM_PROVIDER_ID=custom
# ARENA_CUSTOM_PROVIDER_LABEL=My gateway
# ARENA_API_KEY_ENV=ARENA_API_KEY
# ARENA_API_KEY=
