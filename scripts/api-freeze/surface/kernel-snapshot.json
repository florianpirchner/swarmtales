{
	"additionalProperties": false,
	"description": "The state of the kernel between two ticks",
	"properties": {
		"ended": {
			"additionalProperties": false,
			"description": "How a run ended",
			"properties": {
				"limit": {
					"description": "The id of the run limit that was reached, `<plugin id>.<limit id>`; set when `reason` is `limit`",
					"type": "string"
				},
				"reason": {
					"anyOf": [
						{
							"const": "ticks",
							"type": "string"
						},
						{
							"const": "limit",
							"type": "string"
						},
						{
							"const": "error",
							"type": "string"
						}
					],
					"description": "Why the run ended: the tick limit, a run limit of a plugin, or a failure"
				},
				"tick": {
					"description": "The tick the run ended in",
					"minimum": 0,
					"type": "integer"
				}
			},
			"required": [
				"reason",
				"tick"
			],
			"type": "object"
		},
		"format": {
			"const": "swarmtales.kernel",
			"description": "The format name",
			"type": "string"
		},
		"game": {
			"description": "The id of the game",
			"type": "string"
		},
		"gameHash": {
			"description": "The hash of the game",
			"type": "string"
		},
		"jobs": {
			"description": "The jobs that wait",
			"items": {
				"additionalProperties": false,
				"description": "A scheduled job of a plugin",
				"properties": {
					"data": {
						"$defs": {
							"Json": {
								"$id": "Json",
								"anyOf": [
									{
										"description": "A string",
										"type": "string"
									},
									{
										"description": "A number",
										"type": "number"
									},
									{
										"description": "A boolean",
										"type": "boolean"
									},
									{
										"description": "Null",
										"type": "null"
									},
									{
										"description": "A list of JSON values",
										"items": {
											"$ref": "Json",
											"description": "One entry of the list"
										},
										"type": "array"
									},
									{
										"description": "An object of JSON values",
										"patternProperties": {
											"^.*$": {
												"$ref": "Json",
												"description": "The value of one key"
											}
										},
										"type": "object"
									}
								],
								"description": "A JSON value"
							}
						},
						"$ref": "Json",
						"description": "The data the job was scheduled with: a JSON value"
					},
					"id": {
						"description": "The number of the job, in the order of scheduling",
						"minimum": 0,
						"type": "integer"
					},
					"job": {
						"description": "The name of the job in its plugin",
						"type": "string"
					},
					"next": {
						"description": "The tick it runs at",
						"minimum": 0,
						"type": "integer"
					},
					"owner": {
						"description": "The id of the plugin that owns it",
						"type": "string"
					}
				},
				"required": [
					"id",
					"owner",
					"job",
					"next"
				],
				"type": "object"
			},
			"type": "array"
		},
		"locks": {
			"description": "The locked canonical tools of an actor, sorted, by actor id",
			"patternProperties": {
				"^.*$": {
					"description": "The locked canonical tools of an actor, sorted",
					"items": {
						"description": "A canonical tool name",
						"type": "string"
					},
					"type": "array"
				}
			},
			"type": "object"
		},
		"plugins": {
			"description": "The saved state of the plugins, by plugin id",
			"patternProperties": {
				"^.*$": {
					"additionalProperties": false,
					"description": "The saved state of one plugin",
					"properties": {
						"data": {
							"description": "The state, as its owner saved it; the owner checks it when it loads"
						},
						"version": {
							"description": "The version of the saved form",
							"type": "integer"
						}
					},
					"required": [
						"version",
						"data"
					],
					"type": "object"
				}
			},
			"type": "object"
		},
		"scheduler": {
			"additionalProperties": false,
			"description": "The saved state of the scheduler, when it keeps some",
			"properties": {
				"data": {
					"description": "The state, as its owner saved it; the owner checks it when it loads"
				},
				"version": {
					"description": "The version of the saved form",
					"type": "integer"
				}
			},
			"required": [
				"version",
				"data"
			],
			"type": "object"
		},
		"seed": {
			"description": "The seed of the run",
			"maximum": 4294967295,
			"minimum": 0,
			"type": "integer"
		},
		"seq": {
			"description": "The length of the log at the snapshot",
			"minimum": 0,
			"type": "integer"
		},
		"suspensions": {
			"description": "The ids of the plugins that suspend an actor, by actor id",
			"patternProperties": {
				"^.*$": {
					"description": "The ids of the plugins that suspend an actor",
					"items": {
						"description": "A plugin id",
						"type": "string"
					},
					"type": "array"
				}
			},
			"type": "object"
		},
		"tick": {
			"description": "The tick the run continues with",
			"minimum": 0,
			"type": "integer"
		},
		"version": {
			"const": 1,
			"description": "The format version",
			"type": "number"
		}
	},
	"required": [
		"format",
		"version",
		"game",
		"gameHash",
		"seed",
		"tick",
		"seq",
		"suspensions",
		"locks",
		"jobs",
		"plugins"
	],
	"type": "object"
}
