{
	"name": "@swarmtales/mechanic-progression",
	"version": "0.1.0",
	"description": "Mechanic: levels and doors, submitSolution, tool unlocks per level, acts, the ranking, the task and status lines",
	"type": "module",
	"license": "LicenseRef-SUL-1.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/florianpirchner/swarmtales.git",
		"directory": "mechanics/progression"
	},
	"engines": {
		"node": ">=22.19"
	},
	"sideEffects": false,
	"swarmtales": {
		"kind": "mechanic",
		"class": "game",
		"layer": "L3",
		"mechanics": ["progression"]
	},
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./contract": {
			"development": "./src/contract.ts",
			"types": "./dist/contract.d.ts",
			"default": "./dist/contract.js"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./contract": {
				"types": "./dist/contract.d.ts",
				"default": "./dist/contract.js"
			}
		}
	},
	"files": [
		"dist",
		"prompts"
	],
	"scripts": {
		"build": "tsdown",
		"api": "node ../../scripts/api-report.ts",
		"api:update": "node ../../scripts/api-report.ts --update"
	},
	"dependencies": {
		"@swarmtales/contracts": "workspace:*",
		"@swarmtales/sdk": "workspace:*",
		"@swarmtales/mechanic-contracts": "workspace:*",
		"@swarmtales/mechanic-channels": "workspace:*",
		"@swarmtales/mechanic-exile": "workspace:*",
		"@swarmtales/mechanic-ledger": "workspace:*",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@swarmtales/mechanic-puzzles": "workspace:*",
		"@swarmtales/testkit": "workspace:*"
	}
}
