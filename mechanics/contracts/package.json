{
	"name": "@swarmtales/mechanic-contracts",
	"version": "0.0.0",
	"private": true,
	"description": "The service contracts that have two providers: consensus-source and brain-source",
	"type": "module",
	"license": "Apache-2.0",
	"sideEffects": false,
	"swarmtales": {
		"layer": "L3"
	},
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"api": "api-extractor run",
		"api:update": "api-extractor run --local"
	},
	"dependencies": {
		"@swarmtales/contracts": "workspace:*",
		"@swarmtales/sdk": "workspace:*",
		"typebox": "1.3.27"
	}
}
