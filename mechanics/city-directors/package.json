{
	"name": "@swarmtales/city-directors",
	"version": "0.1.0",
	"description": "Directors: the gamemaker, the Confessor, the judge and the guard of the City and Whispers (decision A58)",
	"type": "module",
	"license": "LicenseRef-SUL-1.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/florianpirchner/swarmtales.git",
		"directory": "mechanics/city-directors"
	},
	"engines": {
		"node": ">=22.19"
	},
	"sideEffects": false,
	"swarmtales": {
		"kind": "mechanic",
		"class": "director",
		"layer": "L3",
		"mechanics": [
			"interpretations"
		]
	},
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"files": [
		"dist",
		"prompts"
	],
	"scripts": {
		"build": "tsdown",
		"api": "node ../../scripts/api-report.ts",
		"api:update": "node ../../scripts/api-report.ts --update"
	},
	"dependencies": {
		"@swarmtales/contracts": "workspace:*",
		"@swarmtales/mechanic-contracts": "workspace:*",
		"@swarmtales/mechanic-receipts": "workspace:*",
		"@swarmtales/sdk": "workspace:*",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@swarmtales/mechanic-channels": "workspace:*",
		"@swarmtales/mechanic-exile": "workspace:*",
		"@swarmtales/mechanic-ledger": "workspace:*",
		"@swarmtales/mechanic-progression": "workspace:*",
		"@swarmtales/mechanic-puzzles": "workspace:*",
		"@swarmtales/mechanic-standoff": "workspace:*",
		"@swarmtales/mechanic-tribunal": "workspace:*",
		"@swarmtales/testkit": "workspace:*"
	}
}
