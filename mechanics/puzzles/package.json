{
	"name": "@swarmtales/mechanic-puzzles",
	"version": "0.0.0",
	"private": true,
	"description": "Mechanic: the pieces of the fragment levels, dealt, held and burned",
	"type": "module",
	"license": "LicenseRef-SUL-1.0",
	"sideEffects": false,
	"swarmtales": {
		"kind": "mechanic",
		"class": "game",
		"layer": "L3",
		"mechanics": ["puzzles"]
	},
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./contract": {
			"development": "./src/contract.ts",
			"types": "./dist/contract.d.ts",
			"default": "./dist/contract.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"api": "api-extractor run",
		"api:update": "api-extractor run --local"
	},
	"dependencies": {
		"@swarmtales/contracts": "workspace:*",
		"@swarmtales/sdk": "workspace:*",
		"@swarmtales/mechanic-exile": "workspace:*",
		"@swarmtales/mechanic-channels": "workspace:*",
		"@swarmtales/mechanic-progression": "workspace:*",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@swarmtales/mechanic-ledger": "workspace:*",
		"@swarmtales/testkit": "workspace:*"
	}
}
