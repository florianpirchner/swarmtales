{
	"name": "@swarmtales/mechanic-exile",
	"version": "0.0.0",
	"private": true,
	"description": "Mechanic: banishing a resident: the gate, the ransom, the last will, one event, one suspension",
	"type": "module",
	"license": "LicenseRef-SUL-1.0",
	"sideEffects": false,
	"swarmtales": {
		"kind": "mechanic",
		"class": "base",
		"layer": "L3",
		"mechanics": ["exile"]
	},
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./contract": {
			"development": "./src/contract.ts",
			"types": "./dist/contract.d.ts",
			"default": "./dist/contract.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"api": "node ../../scripts/api-report.ts",
		"api:update": "node ../../scripts/api-report.ts --update"
	},
	"dependencies": {
		"@swarmtales/contracts": "workspace:*",
		"@swarmtales/mechanic-contracts": "workspace:*",
		"@swarmtales/sdk": "workspace:*",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@swarmtales/testkit": "workspace:*"
	}
}
