{
	"name": "@swarmtales/mechanic-seal",
	"version": "0.0.0",
	"private": true,
	"description": "Mechanic: the black seal: an all-pay auction for one strike per act",
	"type": "module",
	"license": "LicenseRef-SUL-1.0",
	"sideEffects": false,
	"swarmtales": {
		"kind": "mechanic",
		"class": "game",
		"layer": "L3",
		"mechanics": [
			"seal"
		]
	},
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./contract": {
			"development": "./src/contract.ts",
			"types": "./dist/contract.d.ts",
			"default": "./dist/contract.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"api": "node ../../scripts/api-report.ts",
		"api:update": "node ../../scripts/api-report.ts --update"
	},
	"dependencies": {
		"@swarmtales/contracts": "workspace:*",
		"@swarmtales/sdk": "workspace:*",
		"@swarmtales/mechanic-contracts": "workspace:*",
		"@swarmtales/mechanic-channels": "workspace:*",
		"@swarmtales/mechanic-exile": "workspace:*",
		"@swarmtales/mechanic-ledger": "workspace:*",
		"@swarmtales/mechanic-progression": "workspace:*",
		"@swarmtales/mechanic-tribunal": "workspace:*",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@swarmtales/mechanic-goals": "workspace:*",
		"@swarmtales/mechanic-standoff": "workspace:*",
		"@swarmtales/testkit": "workspace:*"
	}
}
