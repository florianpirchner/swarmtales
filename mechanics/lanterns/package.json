{
	"name": "@swarmtales/mechanic-lanterns",
	"version": "0.1.0",
	"description": "Mechanic: the rules of Lanterns",
	"type": "module",
	"license": "LicenseRef-SUL-1.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/florianpirchner/swarmtales.git",
		"directory": "mechanics/lanterns"
	},
	"engines": {
		"node": ">=22.19"
	},
	"sideEffects": false,
	"swarmtales": {
		"kind": "mechanic",
		"class": "game",
		"layer": "L3",
		"mechanics": ["clueGrid"]
	},
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"files": [
		"dist",
		"prompts"
	],
	"scripts": {
		"build": "tsdown",
		"api": "node ../../scripts/api-report.ts",
		"api:update": "node ../../scripts/api-report.ts --update"
	},
	"dependencies": {
		"@swarmtales/contracts": "workspace:*",
		"@swarmtales/sdk": "workspace:*",
		"@swarmtales/mechanic-contracts": "workspace:*",
		"@swarmtales/mechanic-strategy-brain": "workspace:*",
		"@swarmtales/mechanic-team-channel": "workspace:*",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@swarmtales/testkit": "workspace:*"
	}
}
