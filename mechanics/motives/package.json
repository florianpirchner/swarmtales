{
	"name": "@swarmtales/mechanic-motives",
	"version": "0.0.0",
	"private": true,
	"description": "Mechanic: a seeded character (drives, Big Five, figures) in the system prompt",
	"type": "module",
	"license": "LicenseRef-SUL-1.0",
	"sideEffects": false,
	"swarmtales": {
		"kind": "mechanic",
		"class": "game",
		"layer": "L3",
		"mechanics": ["motives"]
	},
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./contract": {
			"development": "./src/contract.ts",
			"types": "./dist/contract.d.ts",
			"default": "./dist/contract.js"
		},
		"./rules": {
			"development": "./src/rules.ts",
			"types": "./dist/rules.d.ts",
			"default": "./dist/rules.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"api": "api-extractor run",
		"api:update": "api-extractor run --local"
	},
	"dependencies": {
		"@swarmtales/contracts": "workspace:*",
		"@swarmtales/mechanic-contracts": "workspace:*",
		"@swarmtales/mechanic-whispers": "workspace:*",
		"@swarmtales/sdk": "workspace:*",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@swarmtales/mechanic-channels": "workspace:*",
		"@swarmtales/mechanic-ledger": "workspace:*",
		"@swarmtales/testkit": "workspace:*"
	}
}
